ACCTUPD DFHMSD TYPE=&&SYSPARM,MODE=INOUT,LANG=COBOL
ACCTUPA DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
        DFHMDF POS=(4,30),LENGTH=14,INITIAL='Update Account'
        DFHMDF POS=(6,5),LENGTH=10,INITIAL='Account : '
ACCTID  DFHMDF POS=(6,16),LENGTH=11,ATTRB=(UNPROT,NUM,IC)
LIMIT   DFHMDF POS=(8,16),LENGTH=12,ATTRB=(UNPROT,NUM)
ERRMSG  DFHMDF POS=(23,1),LENGTH=40,ATTRB=(ASKIP,BRT)
        DFHMSD TYPE=FINAL
